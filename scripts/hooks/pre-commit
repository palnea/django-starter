#!/bin/bash

# Pre-commit hook for Django Starter Project
# This hook runs Black formatting check, Ruff linting, and exception translation validation

# Function to find and activate virtual environment
activate_venv() {
    # Try common virtual environment locations
    local venv_paths=(
        "venv/bin/activate"
        ".venv/bin/activate"
        "$HOME/.virtualenvs/django-starter/bin/activate"
        "env/bin/activate"
    )
    
    for venv_path in "${venv_paths[@]}"; do
        if [ -f "$venv_path" ]; then
            echo "Activating virtual environment: $venv_path"
            source "$venv_path"
            return 0
        fi
    done
    
    echo "Warning: No virtual environment found. Continuing with system Python..."
    return 1
}

# Check if this is a merge commit
if [ -n "$GIT_MERGE_AUTOEDIT" ]; then
    echo "Merge detected. Skipping pre-commit hook."
    exit 0
fi

# Try to activate virtual environment
activate_venv

# Check if bin/lint is available
if [ ! -x "bin/lint" ]; then
    echo "bin/lint not found or not executable. Make sure you are in the project root."
    exit 1
fi

if ! command -v python &> /dev/null; then
    echo "Python is not available. Please check your environment setup."
    exit 1
fi

# Run linting and formatting checks
echo "Running bin/lint checks..."
bin/lint

if [ $? -ne 0 ]; then
    echo "❌ Lint check failed. Please fix the formatting/linting issues and try again."
    echo "   Run: bin/lint --fix"
    exit 1
fi

echo "✅ Lint check passed"

# Check exception translations
echo "Checking exception translations..."
if [ -f "bin/check-translations" ]; then
    poetry run python bin/check-translations
    if [ $? -ne 0 ]; then
        echo "❌ Exception translation check failed."
        exit 1
    fi
    echo "✅ Exception translation check passed"
else
    echo "⚠️  Exception translation checker not found, skipping..."
fi

echo "🎉 All pre-commit checks passed!"
exit 0
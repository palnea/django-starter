# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
#
#     cp .env.example .env
#
# bin/setup creates a .env for you and writes DATABASE_URL into it, so on a
# fresh machine you usually run bin/setup first and only edit this file's
# optional sections afterwards.
#
# .env is gitignored. Never commit real credentials.
#
# Legend:
#   [required]  the app will not start, or the feature is broken, without it
#   [optional]  has a working default, or only needed for that one feature
#
# Every variable below is read somewhere under settings/. See
# docs/operations/settings-and-env.md for what each one actually controls.
# ---------------------------------------------------------------------------


# ── Core Django ─────────────────────────────────────────────────────────────

# Selects which settings module settings/__init__.py loads.
# Accepted: dev | local | development -> settings/development.py
#           test                      -> settings/test.py
#           staging                   -> settings/staging (falls through to dev)
#           prod | production         -> settings/prod.py
# Unset or unrecognised values fall back to development.
# [optional]
ENV=development

# [required] Two valid styles:
#   manage.settings        indirect. Re-exports settings/__init__.py, which picks
#                          the module from $ENV above. Used by bin/server and
#                          bin/check-translations.
#   settings.development   direct. Names one module and ignores $ENV. This is
#                          what bin/setup writes into a fresh .env, and what
#                          bin/celery defaults to.
# Either works. Prefer manage.settings if you want $ENV to have any effect.
DJANGO_SETTINGS_MODULE=manage.settings

# [required in test/prod] Also used as the SIMPLE_JWT signing key.
# base.py ships an insecure development default; test.py and prod.py read this
# variable instead and will produce a None signing key if it is missing.
SECRET_KEY=

# [optional] development.py forces DEBUG=True regardless. Only meaningful when
# you are running a non-development settings module.
DEBUG=False

# [required] Parsed by dj-database-url.
# bin/setup writes this line for you, using whichever port your local
# PostgreSQL is actually serving on.
DATABASE_URL=postgresql://localhost:5432/myapp


# ── Celery / Redis ──────────────────────────────────────────────────────────

# [optional] Defaults to redis://localhost:6379/0.
# bin/celery overrides this to match the Redis instance it starts.
CELERY_BROKER_URL=redis://localhost:6379/0

# [optional] Defaults to django-db (results land in django_celery_results tables).
CELERY_RESULT_BACKEND=django-db

# [optional] Read by bin/celery only, not by Django.
REDIS_PORT=6379
CELERY_APP=manage
CELERY_LOG_LEVEL=info


# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Powers contact_verification emails and anything using communications.EmailService.
# development.py supplies placeholder defaults for all of these.

# [optional]
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=


# ── SMS (NetGSM) ────────────────────────────────────────────────────────────
# Powers contact_verification phone codes via communications.SMSService.

# [optional]
NETGSM_USER_CODE=
NETGSM_PASSWORD=
SMS_HEADER=


# ── Cloud storage ───────────────────────────────────────────────────────────
# Backs common.TranslatedFile uploads. See docs/apps/cloud-storage.md.

# [optional] Which client get_cloud_storage_client() builds. Currently: idrive.
CLOUD_STORAGE_VENDOR=idrive

# [optional] Private and public bucket names, and whether the default bucket
# serves public URLs.
CLOUD_STORAGE_BUCKET_NAME=
CLOUD_STORAGE_PUBLIC_BUCKET_NAME=
CLOUD_STORAGE_BUCKET_IS_PUBLIC=false

# [optional] IDrive e2 (S3-compatible) credentials.
IDRIVE_ENDPOINT_URL=
IDRIVE_ACCESS_KEY=
IDRIVE_SECRET_ACCESS_KEY=
IDRIVE_BUCKET_NAME=

# [optional] Only if you swap the storage vendor for real AWS S3.
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=


# ── Social authentication ───────────────────────────────────────────────────
# See docs/apps/authy.md.

# [required for social login] Shared secret clients must present on the
# /auth/{google,facebook,apple}/ endpoints. base.py defaults to
# "default-social-secret-key". Change it anywhere real.
SOCIAL_SECRET=

# [optional] Sign in with Apple. Needed only for /auth/apple/.
SOCIAL_AUTH_APPLE_KEY_ID=
SOCIAL_AUTH_APPLE_TEAM_ID=
SOCIAL_AUTH_APPLE_PRIVATE_KEY=


# ── Apple in-app purchases / App Store Connect ──────────────────────────────
# Only needed if you keep the payment + vendor apps.
# See docs/apps/payments-and-subscriptions.md.

# [optional]
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_IN_APP_SIGNING_KEY=
APPLE_DEVELOPER_KEY_ID=
APPLE_DEVELOPER_ISSUER_ID=
APPLE_CONNECT_API_KEY_ID=
APPLE_CONNECT_API_SIGNING_KEY=


# ── Google Play billing ─────────────────────────────────────────────────────
# The GOOGLE_PLAY_* block is a service-account JSON split across variables.
# Only needed if you keep the payment + vendor apps.
# development.py supplies non-working placeholder defaults for all of these.

# [optional]
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_RSA_KEY=
GOOGLE_PLAY_TYPE=service_account
GOOGLE_PLAY_PROJECT_ID=
GOOGLE_PLAY_PRIVATE_KEY_ID=
GOOGLE_PLAY_PRIVATE_KEY=
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_CLIENT_ID=
GOOGLE_PLAY_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_PLAY_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_PLAY_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_PLAY_CLIENT_X509_CERT_URL=
GOOGLE_PLAY_UNIVERSE_DOMAIN=googleapis.com


# ── API documentation ───────────────────────────────────────────────────────

# [optional] Gate on /swagger/, /redoc/ and /api/schema/, enforced by
# common.middlewares.swagger_middleware.SwaggerAccessMiddleware.
# development.py defaults it to "swagger". Set a real value in any deployed
# environment, or the schema is public.
SWAGGER_ACCESS_PASSCODE=


# ── bin/setup only ──────────────────────────────────────────────────────────
# Not read by Django. See docs/getting-started.md.

# [optional] Leave unset to adopt whatever port your local PostgreSQL already
# serves on. Set it to force a specific port, and bin/setup will rewrite
# postgresql.conf and restart the service.
# DB_PORT=5432

# [optional] Port used only when bin/setup installs PostgreSQL from scratch.
# PG_FRESH_INSTALL_PORT=5432
